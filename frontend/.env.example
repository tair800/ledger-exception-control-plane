# Operations console — configuration.
# Copy to `.env.local` (git-ignored) and adjust. Never put a real bearer token in here:
# the console takes the token from the operator at sign-in and keeps it in an httpOnly cookie.
#
# None of these is a `NEXT_PUBLIC_` variable, and that is deliberate: every one is read
# server-side only, so nothing here reaches the browser bundle. A test asserts the console
# performs no arithmetic on money; this file's equivalent guarantee is that it holds no value a
# page script could read.

# Base URL of the control plane, without a trailing slash and without the /api/v1 prefix.
# The console's own route handlers append /api/v1 and /healthz themselves.
#   local      http://localhost:8000
#   deployed   the Render service URL, https://<service>.onrender.com
CONTROL_PLANE_BASE_URL=http://localhost:8000

# Upstream request timeout in milliseconds. Bounded so a stalled control plane surfaces as an
# error state in the console rather than as a hanging page.
#
# **The deployed value is much larger than the local one, for a reason worth knowing.** The
# demonstration's backend runs on a free tier that scales to zero, and a cold start is tens of
# seconds. At 8000 the console would report an error on every first visit after an idle period.
# Vercel's Hobby plan caps a function at 60s (the route handlers set `maxDuration = 60`), so the
# deployed value sits just under that ceiling and the console reports a cold start rather than a
# failure.
#   local      8000
#   deployed   55000
CONTROL_PLANE_TIMEOUT_MS=8000

# Set to "true" only when serving the console over HTTPS. It marks the session cookie Secure.
# Left false locally because a Secure cookie is dropped by the browser over plain http.
#   local      false
#   deployed   true
CONSOLE_COOKIE_SECURE=false
